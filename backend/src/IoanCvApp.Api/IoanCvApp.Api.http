@baseUrl = http://localhost:5106

### Check API liveness
GET {{baseUrl}}/health
Accept: application/json

### Get public profile (404 ProblemDetails when no profile exists)
GET {{baseUrl}}/api/public/profile
Accept: application/json

### Get public experience entries in display order
GET {{baseUrl}}/api/public/experience
Accept: application/json

### Get public projects
GET {{baseUrl}}/api/public/projects
Accept: application/json

### Log in as the configured administrator
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "<configured-admin-username>",
  "password": "<configured-admin-password>"
}

### Invalid administrator credentials return a generic 401
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "<configured-admin-username>",
  "password": "<incorrect-password>"
}
